<Window x:Class="DatasetManager.App.Views.MaterializedDatasetCreatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="复制创建数据集" Height="590" Width="700" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="#F7F8FA">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="复制创建数据集" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="读取数据集清单，将图片和标签复制到一个新的独立目录" Foreground="#6B7280" Margin="0,4,0,20"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,0,0,14">
            <TextBlock Text="数据集名称 *" Margin="0,0,0,6"/>
            <TextBox x:Name="NameBox"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="0,0,0,14">
            <TextBlock Text="来源清单（训练集 / 测试集 / 验证集）*" Margin="0,0,0,6"/>
            <ComboBox x:Name="ManifestBox" DisplayMemberPath="DisplayName" Padding="7" SelectionChanged="ManifestBox_SelectionChanged"/>
            <TextBlock x:Name="ManifestDetailsText" Foreground="#6B7280" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="0,0,0,14">
            <TextBlock Text="输出父目录 *" Margin="0,0,0,6"/>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="DestinationBox"/>
                <Button Grid.Column="1" Content="浏览…" Click="BrowseDestination_Click" Margin="8,0,0,0"/>
            </Grid>
            <TextBlock Text="将在这里新建一个与数据集同名的目录；已存在时不会覆盖。" Foreground="#6B7280" FontSize="11" Margin="0,5,0,0"/>
        </StackPanel>
        <Grid Grid.Row="4" Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="图片文件夹名称" Margin="0,0,0,6"/>
                <TextBox x:Name="ImagesFolderBox" Text="images"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="标签文件夹名称" Margin="0,0,0,6"/>
                <TextBox x:Name="LabelsFolderBox" Text="jsons"/>
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="5" Margin="0,0,0,14">
            <TextBlock Text="备注" Margin="0,0,0,6"/>
            <TextBox x:Name="NotesBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="80"/>
        </StackPanel>
        <TextBlock x:Name="ErrorText" Grid.Row="6" Foreground="#DC2626" Margin="0,0,0,8" TextWrapping="Wrap"/>
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" IsCancel="True" MinWidth="88"/>
            <Button Content="开始复制" Click="Create_Click" MinWidth="105" Background="#2563EB" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
