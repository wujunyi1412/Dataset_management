<Window x:Class="DatasetManager.App.Views.DatasetMigrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="迁移数据集" Height="490" Width="700" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="#F7F8FA">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="迁移数据集" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="复制或移动已登记的数据，并同步更新数据集和标注路径" Foreground="#6B7280" Margin="0,4,0,20"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,0,0,14">
            <TextBlock Text="原路径" Margin="0,0,0,6"/>
            <TextBlock x:Name="SourcePathText" TextWrapping="Wrap" Foreground="#4B5563"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="0,0,0,14">
            <TextBlock Text="新路径 *" Margin="0,0,0,6"/>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="DestinationBox"/>
                <Button Grid.Column="1" Content="浏览…" Click="BrowseDestination_Click" Margin="8,0,0,0"/>
            </Grid>
            <TextBlock Text="请指定最终的数据集目录。该目录必须尚不存在，程序不会覆盖已有文件。" Foreground="#6B7280" FontSize="11" Margin="0,5,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="0,0,0,14">
            <TextBlock Text="迁移方式" Margin="0,0,0,7"/>
            <RadioButton x:Name="CopyOption" Content="复制（保留原文件）" IsChecked="True" Margin="0,0,0,7"/>
            <RadioButton x:Name="MoveOption" Content="剪切 / 移动（记录保存成功后删除原文件）"/>
        </StackPanel>
        <Border Grid.Row="4" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,2,0,14">
            <TextBlock TextWrapping="Wrap" Foreground="#1E40AF">
                已处理数据集会同时迁移登记的标签目录。主目录内的标签保留相对位置；主目录外的标签放入新目录的 annotations 子目录。已创建数据集的 dataset.json 内部路径也会同步更新。
            </TextBlock>
        </Border>
        <TextBlock x:Name="ErrorText" Grid.Row="5" Foreground="#DC2626" Margin="0,0,0,8" TextWrapping="Wrap"/>
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" IsCancel="True" MinWidth="88"/>
            <Button Content="开始迁移" Click="Migrate_Click" MinWidth="105" Background="#2563EB" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
