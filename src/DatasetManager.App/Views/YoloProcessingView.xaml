<UserControl x:Class="DatasetManager.App.Views.YoloProcessingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="26,22,26,16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="YOLO处理" FontSize="26" FontWeight="SemiBold" Foreground="#111827"/>
            <TextBlock Text="格式转换 · 重复数据集检查" Foreground="#6B7280" Margin="0,3,0,18"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="0.75*"/></Grid.ColumnDefinitions>
            <TabControl Grid.Column="0" Background="White" BorderBrush="#E5E7EB">
                <TabItem Header="格式转换">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="22">
                            <TextBlock Text="LabelMe JSON → YOLO TXT" FontSize="19" FontWeight="SemiBold"/>
                            <TextBlock Text="只转换下面明确输入的类别；其他类别即使存在于 JSON 中也会忽略。" Foreground="#6B7280" TextWrapping="Wrap" Margin="0,4,0,18"/>
                            <TextBlock Text="LabelMe JSON 目录 *" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,13">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="ConversionSourceBox"/>
                                <Button Grid.Column="1" Content="浏览…" Click="BrowseConversionSource_Click" Margin="8,0,0,0"/>
                            </Grid>
                            <TextBlock Text="YOLO TXT 输出目录 *" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,13">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="ConversionOutputBox"/>
                                <Button Grid.Column="1" Content="浏览…" Click="BrowseConversionOutput_Click" Margin="8,0,0,0"/>
                            </Grid>
                            <TextBlock Text="转换目标 *" Margin="0,0,0,6"/>
                            <ComboBox x:Name="AnnotationTypeBox" Padding="7" SelectedIndex="0" Margin="0,0,0,5">
                                <ComboBoxItem Content="目标检测（外接框：class x_center y_center width height）" Tag="ObjectDetection"/>
                                <ComboBoxItem Content="语义分割（多边形：class x1 y1 x2 y2 …）" Tag="SemanticSegmentation"/>
                            </ComboBox>
                            <TextBlock Text="分割模式会保留 polygon 顶点；LabelMe rectangle 会转换成四个角点。" Foreground="#6B7280" FontSize="11" Margin="0,0,0,13"/>
                            <TextBlock Text="需要转换的类别 *" Margin="0,0,0,6"/>
                            <TextBox x:Name="CategoriesBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90"
                                     ToolTip="按行、逗号或分号分隔；输入顺序就是 YOLO 类别 ID 顺序"/>
                            <TextBlock Text="示例：scratch, particle, haze（依次对应类别 ID 0、1、2）" Foreground="#6B7280" FontSize="11" Margin="0,5,0,13"/>
                            <CheckBox x:Name="CheckEmptyLabelsBox" Content="转换完成后检查本次生成的空标签" IsChecked="True" Margin="0,0,0,7"/>
                            <CheckBox x:Name="DeleteEmptyLabelsBox" Content="删除检查到的空标签 TXT" Margin="20,0,0,5"/>
                            <TextBlock Text="仅检查和删除本次转换生成的 TXT，不处理输出目录中的其他文件。" Foreground="#B45309" FontSize="11" Margin="20,0,0,13"/>
                            <TextBlock Text="操作备注" Margin="0,0,0,6"/>
                            <TextBox x:Name="ConversionNotesBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="62"/>
                            <TextBlock x:Name="ConversionStatusText" Foreground="#2563EB" TextWrapping="Wrap" Margin="0,12,0,4"/>
                            <Button x:Name="ConvertButton" Content="开始转换并记录" Click="Convert_Click" HorizontalAlignment="Left" Background="#2563EB" Foreground="White"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="重复数据集检查">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="22">
                            <TextBlock Text="YOLO TXT 文件名重复检查" FontSize="19" FontWeight="SemiBold"/>
                            <TextBlock Text="递归比较两个目录中的实际 .txt 标签文件，忽略大小写，不比较文件内容。" Foreground="#6B7280" TextWrapping="Wrap" Margin="0,4,0,18"/>
                            <TextBlock Text="目录 A *" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,13">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="FolderABox"/>
                                <Button Grid.Column="1" Content="浏览…" Click="BrowseFolderA_Click" Margin="8,0,0,0"/>
                            </Grid>
                            <TextBlock Text="目录 B *" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,13">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="FolderBBox"/>
                                <Button Grid.Column="1" Content="浏览…" Click="BrowseFolderB_Click" Margin="8,0,0,0"/>
                            </Grid>
                            <Button Content="检查重复" Click="CheckDuplicates_Click" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="DuplicateResultText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,6"/>
                            <TextBox x:Name="DuplicateNamesBox" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" MinHeight="100" MaxHeight="180"/>
                            <TextBlock Text="处理方式" Margin="0,13,0,6"/>
                            <ComboBox x:Name="DeleteTargetBox" Padding="7" SelectedIndex="0">
                                <ComboBoxItem Content="不删除，只保存检查记录" Tag="None"/>
                                <ComboBoxItem Content="删除目录 A 中的重复 TXT" Tag="FolderA"/>
                                <ComboBoxItem Content="删除目录 B 中的重复 TXT" Tag="FolderB"/>
                            </ComboBox>
                            <TextBlock Text="删除只针对上面列出的重复 .txt 文件，不删除目录、图片或其他文件。" Foreground="#B45309" FontSize="11" Margin="0,5,0,13"/>
                            <TextBlock Text="操作备注" Margin="0,0,0,6"/>
                            <TextBox x:Name="DuplicateNotesBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="62"/>
                            <TextBlock x:Name="DuplicateStatusText" Foreground="#2563EB" TextWrapping="Wrap" Margin="0,12,0,4"/>
                            <Button Content="执行并保存记录" Click="ExecuteDuplicateAction_Click" HorizontalAlignment="Left" Background="#2563EB" Foreground="White"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
            <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="18">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock Text="操作记录" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="格式转换和重复检查完成后会自动记录在这里" Foreground="#6B7280" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Grid>
                    <TextBlock x:Name="EmptyRecordsText" Text="暂无操作记录&#x0a;&#x0a;请先在左侧执行一次格式转换，或完成重复数据集检查并保存记录。"
                               Foreground="#9CA3AF" TextAlignment="Center" TextWrapping="Wrap"
                               HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="230"/>
                    <ListBox x:Name="OperationRecordsList" ItemsSource="{Binding OperationRecords}" BorderThickness="0" Background="Transparent" Visibility="Collapsed">
                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="9"/></Style></ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Summary}" Foreground="#4B5563" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding SourcePathA}" Foreground="#6B7280" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding SourcePathB}" Foreground="#6B7280" FontSize="11" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding OutputPath}" Foreground="#2563EB" FontSize="11" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Notes}" Foreground="#6B7280" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Foreground="#9CA3AF" FontSize="11" Margin="0,3,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
