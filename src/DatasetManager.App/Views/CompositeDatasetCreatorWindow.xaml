<Window x:Class="DatasetManager.App.Views.CompositeDatasetCreatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="创建数据集" Height="720" Width="820" WindowStartupLocation="CenterOwner"
        MinHeight="650" MinWidth="760" Background="#F7F8FA">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="HeadingText" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="从已处理数据集的标注批次中自由组合图片与标签对" Foreground="#6B7280" Margin="0,4,0,20"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="数据集名称 *" Margin="0,0,0,6"/>
                <TextBox x:Name="NameBox"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="清单保存目录 *" Margin="0,0,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="OutputBox"/>
                    <Button Grid.Column="1" Content="浏览…" Click="BrowseOutput_Click" Margin="8,0,0,0"/>
                </Grid>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Background="White" CornerRadius="7" Padding="16" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition Width="180"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="已处理数据集" Margin="0,0,0,6"/>
                    <ComboBox x:Name="DatasetBox" DisplayMemberPath="Name" SelectionChanged="DatasetBox_SelectionChanged" Padding="6"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="标注批次" Margin="0,0,0,6"/>
                    <ComboBox x:Name="AnnotationBox" DisplayMemberPath="Name" Padding="6" SelectionChanged="AnnotationBox_SelectionChanged"/>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="选取数量" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox x:Name="UseAllCheck" Content="全部" IsChecked="True" VerticalAlignment="Center" Checked="UseAll_Changed" Unchecked="UseAll_Changed"/>
                        <TextBox x:Name="CountBox" Width="62" Margin="12,0,0,0" IsEnabled="False" TextChanged="CountBox_TextChanged"/>
                        <TextBlock x:Name="AvailableCountText" Text=" / 请选择标注" VerticalAlignment="Center" Foreground="#6B7280" Margin="5,0,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Button x:Name="AddSourceButton" Grid.Column="5" Content="加入来源" Click="AddSource_Click" VerticalAlignment="Bottom" Margin="12,0,0,0"/>
                <Border Grid.Row="1" Grid.ColumnSpan="6" Background="#EFF6FF" CornerRadius="5" Padding="10,7" Margin="0,10,0,0">
                    <TextBlock x:Name="AnnotationNotesText" Text="标注备注：请选择标注批次" Foreground="#374151" TextWrapping="Wrap"/>
                </Border>
                <TextBlock x:Name="SourceErrorText" Grid.Row="2" Grid.ColumnSpan="6" Foreground="#DC2626" Margin="0,8,0,0" TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <DockPanel Grid.Row="3" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="移除选中来源" Click="RemoveSource_Click"/>
            <TextBlock Text="已选择的组成来源" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </DockPanel>
        <ListBox Grid.Row="4" x:Name="SourcesList" ItemsSource="{Binding Sources}" Background="White" BorderBrush="#E5E7EB">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="10"/></Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Dataset.Name}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Annotation.Name}" Foreground="#6B7280" Margin="0,3,0,0"/>
                            <TextBlock Text="{Binding AnnotationNotes}" Foreground="#4B5563" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding CountSummary}" Foreground="#2563EB" VerticalAlignment="Center"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="5" Margin="0,14,0,12">
            <TextBlock Text="补充备注" Margin="0,0,0,6"/>
            <TextBox x:Name="NotesBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" VerticalScrollBarVisibility="Auto"/>
            <TextBlock Text="来源组成会自动写入备注；清单只记录绝对路径，不复制图片和标签。" Foreground="#6B7280" FontSize="11" Margin="0,5,0,0"/>
        </StackPanel>
        <TextBlock x:Name="ErrorText" Grid.Row="6" Foreground="#DC2626" Margin="0,0,0,8" TextWrapping="Wrap"/>
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" IsCancel="True" MinWidth="88"/>
            <Button Content="创建数据集" Click="Create_Click" MinWidth="110" Background="#2563EB" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
